# Aviasales MCP Server Configuration

# Travelpayouts API Token (required)
# Get it at: https://www.travelpayouts.com/programs/100/tools/api
AVIASALES_API_TOKEN=

# Travelpayouts Partner ID (for booking links, found in your dashboard)
AVIASALES_PARTNER_ID=

# Server settings
LOG_LEVEL=INFO

# Optional HTTP transport. Leave MCP_PORT unset to speak stdio, which is what
# local MCP clients expect. Set it to serve streamable-http on that port —
# use MCP_HOST=0.0.0.0 inside Docker, and always set MCP_AUTH_TOKEN, otherwise
# anyone who can reach the port can spend your Travelpayouts quota.
# MCP_PORT=8080
# MCP_HOST=127.0.0.1
# MCP_AUTH_TOKEN=

# Send the token as "Authorization: Bearer <token>". Set this only for clients
# that cannot set headers — query strings are written to access logs.
# MCP_AUTH_ALLOW_QUERY_TOKEN=false

# Binding a non-loopback address without a token refuses to start. Override
# only when the port is genuinely private.
# MCP_ALLOW_INSECURE_HTTP=false
