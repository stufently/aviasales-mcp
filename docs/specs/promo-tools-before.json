 {
  "name": "lookup_airlines",
  "inputSchema": {
   "additionalProperties": false,
   "properties": {
    "search": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "Airline name substring or exact IATA code (e.g. \"aeroflot\", \"SU\").\nOmit to list airlines from the start of the dataset."
    },
    "limit": {
     "default": 50,
     "maximum": 500,
     "minimum": 1,
     "type": "integer",
     "description": "Max results to return (1-500, default 50)."
    },
    "locale": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "2-letter locale for names (e.g. \"en\", \"ru\"). Defaults to the\nserver's locale."
    }
   },
   "type": "object"
  }
 },
