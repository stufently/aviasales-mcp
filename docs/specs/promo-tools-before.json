     "minimum": 0,
     "type": "integer",
     "description": "Highest acceptable price, in `currency`."
    },
    "destination": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "Destination IATA code. Optional — omit to search anywhere."
    },
    "limit": {
     "default": 20,
     "maximum": 100,
     "minimum": 1,
     "type": "integer",
     "description": "Max results (1-100, default 20)."
    },
    "currency": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "Price currency (3 letters). Defaults to the server's currency."
    },
    "market": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "2-letter market whose price cache to read. Defaults to the\nserver's configured market."
    }
   },
   "required": [
    "origin",
    "value_min",
    "value_max"
   ],
   "type": "object"
  }
