 {
  "name": "find_nearest_airports",
  "inputSchema": {
   "additionalProperties": false,
   "properties": {
    "near": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "Place name or IATA code to search around (e.g. \"Pattaya\", \"UTP\")."
    },
    "latitude": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "Latitude in degrees, -90 to 90. Overrides `near`."
    },
    "longitude": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "Longitude in degrees, -180 to 180. Overrides `near`."
    },
    "limit": {
     "default": 5,
     "maximum": 50,
     "minimum": 1,
     "type": "integer",
     "description": "Max airports to return (1-50, default 5)."
    },
    "max_distance_km": {
     "anyOf": [
      {
       "exclusiveMinimum": 0,
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "Ignore airports further away than this. Optional."
    },
    "flightable_only": {
     "default": true,
     "type": "boolean",
     "description": "Skip airports with no scheduled service (default True)."
    },
    "locale": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "2-letter locale for names. Defaults to the server's locale."
    }
   },
   "type": "object"
  }
 }
