 {
  "name": "search_by_price_range",
  "inputSchema": {
   "additionalProperties": false,
   "properties": {
    "origin": {
     "type": "string",
     "description": "Origin IATA code."
    },
    "value_min": {
     "minimum": 0,
     "type": "integer",
     "description": "Lowest acceptable price, in `currency`."
    },
