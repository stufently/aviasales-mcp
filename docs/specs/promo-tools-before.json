[
 {
  "name": "search_flights",
  "inputSchema": {
   "additionalProperties": false,
   "properties": {
    "origin": {
     "type": "string",
     "description": "Origin city IATA code (e.g. \"MOW\", \"LED\")."
    },
    "destination": {
     "type": "string",
     "description": "Destination city IATA code (e.g. \"IST\", \"BCN\")."
    },
    "departure_at": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "Departure date or month (YYYY-MM-DD or YYYY-MM). Optional;\na month searches every day in it."
    },
    "return_at": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "Return date or month (YYYY-MM-DD or YYYY-MM). Optional."
    },
    "direct": {
     "default": false,
     "type": "boolean",
     "description": "If True, show only non-stop flights."
    },
    "limit": {
     "default": 10,
     "maximum": 100,
     "minimum": 1,
     "type": "integer",
     "description": "Max number of results (1-100, default 10)."
    },
    "currency": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "Price currency code (3 letters, e.g. \"rub\", \"usd\"). Defaults to\nthe server's configured currency."
    },
    "market": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "2-letter market whose price cache to read (e.g. \"us\", \"ru\", \"th\").\nThe same route in the same currency is priced differently per market,\nso set this to the traveller's country. Defaults to the server's\nconfigured market."
    },
    "one_way": {
     "default": false,
     "type": "boolean",
     "description": "If True, search one-way tickets only."
    },
    "adults": {
     "default": 1,
     "maximum": 9,
     "minimum": 1,
     "type": "integer",
     "description": "Number of adult passengers, 1-9 (default 1)."
    },
    "children": {
     "default": 0,
     "maximum": 8,
     "minimum": 0,
     "type": "integer",
     "description": "Number of children 2-11 years, 0-8 (default 0). Adults plus\nchildren cannot exceed 9; the excess is trimmed."
    },
    "infants": {
     "default": 0,
     "maximum": 8,
     "minimum": 0,
     "type": "integer",
     "description": "Number of infants under 2, 0-8 (default 0). Cannot exceed the\nnumber of adults; the excess is trimmed."
    },
    "trip_class": {
     "default": "economy",
     "enum": [
      "economy",
      "comfort",
      "business",
      "first"
     ],
     "type": "string",
     "description": "\"economy\", \"comfort\", \"business\" or \"first\" (default \"economy\")."
    },
    "depart_after": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "Keep only flights departing at or after this local time\n(\"HH:MM\", 24-hour). Optional."
    },
    "depart_before": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "description": "Keep only flights departing at or before this local time\n(\"HH:MM\", 24-hour). Optional. Combined with depart_after and set\nearlier than it, the window wraps midnight (e.g. 22:00-06:00)."
    }
   },
   "required": [
    "origin",
    "destination"
   ],
   "type": "object"
  }
 },
