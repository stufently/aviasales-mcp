    },
    "trip_class": {
     "default": "economy",
     "enum": [
      "economy",
      "comfort",
      "business",
      "first"
     ],
     "type": "string",
     "description": "\"economy\", \"comfort\", \"business\" or \"first\" (default \"economy\")."
    }
   },
   "required": [
